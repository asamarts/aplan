# Self-hosted runner configuration for aplan CI (the pre-public repository-boundary decision).
# Copy to ci/.env (gitignored) and fill in the values before running setup.sh.

# Required: the repository the runner registers against.
GITHUB_REPO_URL=https://github.com/asamarts/aplan

# Required: a runner REGISTRATION token (short-lived, ~1 hour, used once).
# Get it from: repo Settings -> Actions -> Runners -> New self-hosted runner.
# The durable runner identity is persisted to the config volume after the first
# registration, so restarts and reboots never need a new token.
GITHUB_TOKEN=

# Optional: runner name (default: aplan-runner).
RUNNER_NAME=aplan-runner

# Optional: runner labels the workflow targets (default below). Keep in sync
# with `runs-on: [self-hosted, linux, aplan]` in .github/workflows/ci.yml.
RUNNER_LABELS=self-hosted,linux,aplan

# Optional: image and container names (defaults: aplan-runner).
RUNNER_IMAGE=aplan-runner
CONTAINER_NAME=aplan-runner
