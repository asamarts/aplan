# Self-hosted GitHub Actions runner image for aplan CI (the pre-public repository-boundary decision).
# Minimal on purpose: this carries the Rust toolchain, Python for the committed
# performance-harness tests, git, a C toolchain (for git2's vendored libgit2,
# which aplan builds with default-features = false, so no OpenSSL), and the
# runner agent.
FROM debian:bookworm-slim

ARG RUNNER_VERSION=2.336.0
ARG GH_VERSION=2.63.2
ARG LLVM_COV_VERSION=0.8.7
ARG LLVM_COV_X86_64_SHA256=9a75fe29538d3800b3da57f6f6efb64cba5c720a257bf0cb8b51f39d495a9168
ARG LLVM_COV_AARCH64_SHA256=8f399d84993d13998b63fbe1084377713c719b00655c7d88d5b56c8c29105d90

# System packages. libicu72 + zlib1g are what the runner agent's .NET host and
# ./bin/installdependencies.sh need; build-essential + git + pkg-config + zlib1g-dev
# cover aplan's only -sys deps (libgit2-sys vendors libgit2 via cc; libz-sys links
# zlib). No Node or OpenSSL: aplan's git2 is default-features = false, so the
# dependency tree pulls no openssl-sys.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    pkg-config \
    python3 \
    libicu72 \
    zlib1g \
    zlib1g-dev \
    musl-tools \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain. `rust-toolchain.toml` is the one version/component source for
# local rustup, this image and hosted preparation (ADR-0052). The image still
# bakes it in: a Rust bump is a deliberate image rebuild, never a silent
# per-job download. CARGO_HOME/registry and CARGO_TARGET_DIR are mounted as
# persistent volumes at runtime (ci/runner/setup.sh); both directories are
# created and owned by `runner` here so podman's first-use copy-up hands the
# volume that ownership.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/home/runner/cargo-target \
    PATH="/usr/local/cargo/bin:${PATH}"

# The build context is the repository root (enforced by runner/setup.sh), so the
# image consumes the same contract as every checkout rather than an ARG copy.
COPY rust-toolchain.toml /tmp/aplan-rust-toolchain.toml
COPY ci/scripts/toolchain.sh /tmp/aplan-toolchain.sh

# The musl target builds the release artifact (`ci/scripts/release.sh`, A1-028).
# It is statically linked, so the published binary runs on a consumer's runner
# whatever glibc that image ships, rather than on this image's alone; `musl-tools`
# above provides the linker it needs.
RUN chmod +x /tmp/aplan-toolchain.sh \
    && RUST_VERSION="$(/tmp/aplan-toolchain.sh channel /tmp/aplan-rust-toolchain.toml)" \
    && RUST_COMPONENTS="$(/tmp/aplan-toolchain.sh components /tmp/aplan-rust-toolchain.toml)" \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
       | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal \
         --component "${RUST_COMPONENTS}" \
    && rustup component add llvm-tools-preview --toolchain "${RUST_VERSION}" \
    && rustup target add x86_64-unknown-linux-musl --toolchain "${RUST_VERSION}" \
    && rm /tmp/aplan-rust-toolchain.toml /tmp/aplan-toolchain.sh

# The shared test gate uses the exact prebuilt nextest release admitted by
# A1-610. The installer and its checksums are the same files hosted setup uses;
# the workspace MSRV never compiles this CI utility from source.
COPY ci/nextest.env /tmp/aplan-ci/nextest.env
COPY ci/scripts/install-nextest.sh /tmp/aplan-ci/scripts/install-nextest.sh
COPY ci/deny.env /tmp/aplan-ci/deny.env
COPY ci/scripts/install-cargo-deny.sh /tmp/aplan-ci/scripts/install-cargo-deny.sh
RUN chmod +x /tmp/aplan-ci/scripts/install-nextest.sh \
    /tmp/aplan-ci/scripts/install-cargo-deny.sh \
    && mkdir -p /root/.tmp \
    && /tmp/aplan-ci/scripts/install-nextest.sh install /usr/local/cargo/bin \
    && /tmp/aplan-ci/scripts/install-cargo-deny.sh install /usr/local/cargo/bin \
    && rmdir /root/.tmp \
    && rm -r /tmp/aplan-ci

# The coverage gate (`ci/scripts/coverage.sh`, A1-046) needs `cargo llvm-cov` and
# the `llvm-tools-preview` component added above. Installed from the project's
# prebuilt tarball rather than `cargo install`, which would compile it on every
# image build; pinned like the runner agent and gh, so a version change is a
# visible edit here rather than a silent drift between image rebuilds.
RUN DPKG_ARCH=$(dpkg --print-architecture) \
    && case "$DPKG_ARCH" in \
         amd64) ARCH=x86_64; SHA256="$LLVM_COV_X86_64_SHA256" ;; \
         arm64) ARCH=aarch64; SHA256="$LLVM_COV_AARCH64_SHA256" ;; \
         *) echo "unsupported cargo-llvm-cov architecture: $DPKG_ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o llvm-cov.tar.gz \
       "https://github.com/taiki-e/cargo-llvm-cov/releases/download/v${LLVM_COV_VERSION}/cargo-llvm-cov-${ARCH}-unknown-linux-gnu.tar.gz" \
    && printf '%s  %s\n' "$SHA256" llvm-cov.tar.gz | sha256sum -c - \
    && tar -xzf llvm-cov.tar.gz \
    && install -m 0755 cargo-llvm-cov /usr/local/cargo/bin/cargo-llvm-cov \
    && rm -f llvm-cov.tar.gz cargo-llvm-cov

# The GitHub CLI, used by the release workflow to publish a release and upload its
# assets. Pinned and downloaded the same way the runner agent below is, rather
# than added as an apt source, so the image has one fewer moving repository and
# the version is visible here.
RUN DPKG_ARCH=$(dpkg --print-architecture) \
    && curl -fsSL -o gh.tar.gz \
       "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${DPKG_ARCH}.tar.gz" \
    && tar -xzf gh.tar.gz \
    && install -m 0755 "gh_${GH_VERSION}_linux_${DPKG_ARCH}/bin/gh" /usr/local/bin/gh \
    && rm -rf gh.tar.gz "gh_${GH_VERSION}_linux_${DPKG_ARCH}"

# Non-root runner user. Pre-create every path a persistent volume mounts on
# (config, cargo registry, CARGO_TARGET_DIR) and chown them to `runner`, so
# podman's first-use copy-up hands each fresh volume that ownership. Without this
# the registry/target volumes mount as root-owned and every cargo step fails with
# a permission error (aplan runs no `cargo install`, so nothing else creates the
# registry directory in the image first).
RUN useradd -m -d /home/runner -s /bin/bash runner \
    && mkdir -p /home/runner/cargo-target /home/runner/_config /usr/local/cargo/registry \
    && chown -R runner:runner /home/runner /usr/local/cargo

# GitHub Actions runner agent.
WORKDIR /home/runner/actions-runner
RUN DPKG_ARCH=$(dpkg --print-architecture) \
    && case "$DPKG_ARCH" in amd64) ARCH=x64 ;; arm64) ARCH=arm64 ;; *) ARCH="$DPKG_ARCH" ;; esac \
    && curl -fsSL -o runner.tar.gz \
       "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${ARCH}-${RUNNER_VERSION}.tar.gz" \
    && tar xzf runner.tar.gz \
    && rm runner.tar.gz \
    && ./bin/installdependencies.sh \
    && chown -R runner:runner /home/runner \
    && chown -R runner:runner /usr/local/cargo /usr/local/rustup

# CI needs file and line information in workspace panics, not full dependency
# debugger state. Immutable checkouts also gain nothing from incremental state.
# The same file is installed by prepare-hosted.sh so runner placement cannot
# silently change artifact size, compile cost or cache compatibility. Measured
# before A1-632, these settings cut a cold test build from 755 to 537 CPU-s and
# 20 to 5.2 GB, and an edit rebuild from 299 to 137 CPU-s and 16 to 5 GiB peak
# RSS. Keep this copy late so profile edits do not invalidate tool installation.
COPY --chown=runner:runner ci/cargo-ci-config.toml /usr/local/cargo/config.toml

COPY ci/runner/entrypoint.sh /home/runner/entrypoint.sh
COPY ci/runner/job-started.sh /home/runner/job-started.sh
COPY ci/runner/reclaim-coverage.py /home/runner/reclaim-coverage.py
RUN chmod +x /home/runner/entrypoint.sh /home/runner/job-started.sh /home/runner/reclaim-coverage.py

USER runner
WORKDIR /home/runner/actions-runner

ENTRYPOINT ["/home/runner/entrypoint.sh"]
