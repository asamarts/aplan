#!/usr/bin/env bash
# Git pre-push hook: run the change-aware development validation profile over
# the exact updates Git is about to send plus the current working tree.
#
# Install (opt-in):
#   git config core.hooksPath ci/githooks
#
# Skip for one push (a WIP branch):
#   git push --no-verify
#
set -euo pipefail

# Git passes one line per ref on stdin: <local-ref> <local-sha> <remote-ref>
# <remote-sha>. Preserve every non-deletion pair: a multi-ref push is one
# selection over the union, not whichever line happened to arrive first.
declare -a preflight_args=()
saw_update=0
saw_non_deletion=0
while read -r local_ref local_sha remote_ref remote_sha extra; do
    [[ -n "$local_ref" && -n "$local_sha" && -n "$remote_ref" && -n "$remote_sha" \
        && -z "${extra:-}" ]] || {
        echo "pre-push: malformed ref update from Git; validation did not run" >&2
        exit 2
    }
    saw_update=1
    if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
    fi
    saw_non_deletion=1
    preflight_args+=(--pre-push "$remote_sha" "$local_sha")
done

if [[ "$saw_update" -eq 1 && "$saw_non_deletion" -eq 0 ]]; then
    echo "pre-push: deletion-only update; validation not required"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Git deliberately exports repository-local variables to hooks. They are useful
# above, while locating the checkout this hook belongs to, but are actively
# harmful to the gate: tests create their own repositories, and an inherited
# GIT_DIR makes their Git commands mutate this checkout instead. Ask Git for the
# complete version-specific list rather than maintaining a partial copy here.
while IFS= read -r name; do
    if [[ -n "$name" ]]; then
        unset "$name"
    fi
done < <(git rev-parse --local-env-vars)

if [[ "$saw_update" -eq 0 ]]; then
    echo "pre-push: no ref updates supplied; validating the working tree"
fi
exec "$REPO_ROOT/ci/scripts/preflight.sh" "${preflight_args[@]}"
